from pygame import *
from random import randint
window = display.set_mode((700,500))
display.set_caption('пинг-понг')
background = transform.scale(image.load('background.jpg'),(700,500))
clock = time.Clock()
font.init()
font1 = font.SysFont(None,36)
font2 = font.SysFont(None,60)

class GameSprite(sprite.Sprite):
    def __init__(self,player_image,player_x,player_y,player_speed,h,w):
        super().__init__()
        self.image = transform.scale(image.load(player_image),(h,w))
        self.speed = player_speed
        self.rect = self.image.get_rect()
        self.rect.x = player_x
        self.rect.y = player_y
    def reset(self):
        window.blit(self.image,(self.rect.x, self.rect.y))
class Player(GameSprite):
    def update(self):
        keys = key.get_pressed()
        if keys[K_LEFT]and self.rect.x>5:
            self.rect.x -= self.speed
        if keys[K_RIGHT]and self.rect.x<700-80:
            self.rect.x += self.speed
rock1 = Player('rocket.jpg', 100,200,10,100,100)
FPS = 60
game = True
finish = False
while game:
    window.blit(background,(0,0))
    rock1.update()
    for e in event.get():
        if e.type == QUIT:
            game = False 
    clock.tick(FPS)
    display.update()
